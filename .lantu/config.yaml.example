providers:
  - name: deepseek-v4-flash
    protocol: openai-compat
    base_url: https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1
    api_key: ${OPENAI_API_KEY}
    model: deepseek-v4-flash
    thinking: false

permission_mode: default

mcp_servers:
  - name: context7
    command: npx
    args: ["-y", "@upstash/context7-mcp"]

  # zvec-grep local search server. Start it with:
  # zg --server on --mcp-toolset full
  # - name: zvec_grep
  #   url: http://127.0.0.1:7999/mcp

  # Streamable HTTP example (2025-03-26 spec, default when url is set):
  # - name: my-http-mcp
  #   url: https://example.com/mcp
  #   transport: http   # optional; "http" (default) or "sse"
  #   headers:
  #     Authorization: "Bearer ${MY_TOKEN}"
