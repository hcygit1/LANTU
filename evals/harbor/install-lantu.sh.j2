#!/bin/bash
set -euo pipefail

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y curl git
curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="$HOME/.local/bin:$PATH"

{% if version %}
uv tool install --force --from git+https://github.com/hcygit1/LANTU.git@{{ version }} lantu
{% else %}
uv tool install --force --from git+https://github.com/hcygit1/LANTU.git@00a4ea0317c14c2c44cfc736a85408157a016442 lantu
{% endif %}

lantu --help >/dev/null
